<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>acdat</AssemblyName>
    <RootNamespace>AcUnreal.DatExtract</RootNamespace>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ACE.DatLoader uses log4net; silence the unconfigured-appender warning. -->
    <NoWarn>NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.17" />
  </ItemGroup>

  <ItemGroup>
    <!-- Path resolved by Directory.Build.props (AcePath / ACE_PATH); see that
         file. Replaces the hard-coded ..\..\..\ACE junction-dependent path. -->
    <ProjectReference Include="$(AceDatLoaderProject)" />
  </ItemGroup>

</Project>
