# Local-only: agent worktrees (see .github/skills/create-new-branch)
.worktrees/

# =====================================================================
# Unreal Engine 5 .gitignore for ac-unreal
# Sources: official UE 5.x recommendations; tuned for our layout.
# Anything generated by UBT/the Editor, or pulled from the DDC, MUST NOT
# be committed. Asset binaries imported into Content/ go through Git LFS
# (see .gitattributes), not raw git.
# =====================================================================

# --- UE generated -----------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
.vs/
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.xcodeproj/
*.xcworkspace/
*.user
*.userprefs

# --- Compiled UE C++ artifacts ----------------------------------------
*.obj
*.o
*.lib
*.a
*.so
*.dylib
*.dll
*.pdb
*.exp
*.ilk
*.idb

# --- UE generated project files (regenerate locally via UBT) ----------
# Keep the .uproject; never commit the generated VS solution.
*.sln

# --- Standalone coord-transform test rig build output -----------------
pipeline/coord-transform/build/
pipeline/coord-transform/*.exe
pipeline/coord-transform/*.obj
pipeline/coord-transform/*.pdb

# --- Editor crash dumps / logs ----------------------------------------
Saved/Crashes/
Saved/Logs/
*.dmp

# --- OS noise ---------------------------------------------------------
Thumbs.db
ehthumbs.db
.DS_Store
desktop.ini

# --- IDE / tool caches ------------------------------------------------
.idea/
.vscode/
.vs/
*.swp
*~

# --- Local secrets (must never be committed) --------------------------
*.local.ini
*.local.json
.env
.env.local

# --- Decompile artifacts landing zone ---------------------------------
# This directory receives outputs from the SEPARATE decompile agent.
# Treat its contents as opaque inputs; do not commit raw copyrighted
# binaries here. Document expected formats in contract/.
contract/decompile-artifacts/*
!contract/decompile-artifacts/.gitkeep
!contract/decompile-artifacts/README.md
!contract/decompile-artifacts/physics-feel-spec-response.md

# UE auto-creates per-developer collection folders; don't commit.
Content/Developers/

# Python caches
__pycache__/
*.pyc
